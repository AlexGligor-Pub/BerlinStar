# Caddy edge — TLS automat (Let's Encrypt) pentru professorprime.ro
# Reverse-proxy catre containerul frontend (nginx) pe reteaua interna `web`.

{
    email contact@professorprime.ro
}

# Site-ul public de programari (containerul `public-calendar`), sub
# /public-calendar/. Prefixul se taie: aplicatia foloseste doar cai relative.
# Serverul MCP al programarilor online (/mcp/<garaj>), direct la backend.
(mcp) {
    handle /mcp/* {
        reverse_proxy backend:8000
    }
}

(public_calendar) {
    redir /public-calendar /public-calendar/ 308
    handle_path /public-calendar/* {
        reverse_proxy public-calendar:80
    }
}

professorprime.ro {
    import mcp
    import public_calendar
    handle {
        reverse_proxy frontend:80
    }
}

# www → redirect 301 la apex (acoperit si el de certificat)
www.professorprime.ro {
    redir https://professorprime.ro{uri} permanent
}

# Fallback HTTP pentru fereastra de tranzitie DNS (acces direct pe IP sau
# request-uri proxy-ate de RockHost cu Host = IP). Serveste acelasi frontend.
:80 {
    import mcp
    import public_calendar
    handle {
        reverse_proxy frontend:80
    }
}

# Site-uri locale ale serverului (deploy/caddy-sites/*.caddy, in afara git-ului),
# ex. numele public al QA. Pe un server fara ele, importul nu face nimic.
import /etc/caddy/sites/*.caddy
