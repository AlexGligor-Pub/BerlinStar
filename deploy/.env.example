# IP-ul serverului (sau domeniul când îl ai)
SERVER_IP=46.224.120.225

# PostgreSQL
POSTGRES_USER=berlinstar
POSTGRES_PASSWORD=schimba_asta_cu_parola_puternica
POSTGRES_DB=berlinstar

# URL complet pentru SQLAlchemy async (asyncpg driver)
# Format: postgresql+asyncpg://user:password@hostname:port/dbname
# hostname = "db" (numele serviciului Docker)
DATABASE_URL=postgresql+asyncpg://berlinstar:schimba_asta_cu_parola_puternica@db:5432/berlinstar

# JWT Secret Key — generează cu: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=schimba_asta_cu_cheie_random_puternica

# CORS — originile permise pentru browser requests
# La IP direct: http://46.224.120.225
# Când ai domeniu: https://berlinstar.ro
CORS_ORIGINS=http://46.224.120.225

# Base path pentru frontend (cu slash la inceput si sfarsit)
# Daca frontend e la domeniu.ro/berlinstar/ → /berlinstar/
# Daca frontend e la radacina → /
VITE_BASE_PATH=/berlinstar/
