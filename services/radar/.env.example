# Baza de date: acelasi DSN ca al monolitului (schema `radar` e a serviciului).
RADAR_DATABASE_URL=postgresql+asyncpg://user:parola@db:5432/berlinstar
# Secret comun cu monolitul (header X-Service-Token).
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RADAR_SHARED_SECRET=
# Monolitul, pentru /api/internal/business-context si /api/internal/ai-config.
MONOLITH_URL=http://backend:8000
# Buget maxim pe o rulare; peste el raportul se incheie parcial.
RADAR_MAX_RUN_COST_USD=3.0
RADAR_LOG_LEVEL=INFO
TZ=Europe/Bucharest
