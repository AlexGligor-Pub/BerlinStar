# Se copiază în ~/.config/berlinstar-agent-bridge.env (chmod 600).
# NU se comite cu valori reale.
ANTHROPIC_API_KEY=sk-ant-...
BRIDGE_SHARED_SECRET=genereaza-cu-openssl-rand-hex-32
BERLINSTAR_DIR=/home/berlinqa/berlinstar
AGENT_PERMISSION_MODE=bypassPermissions
# AGENT_MODEL=claude-opus-4-8   # opțional; gol => default-ul CLI-ului
AGENT_MAX_TURNS=80
